{
  "name": "qingzhi-huanxin-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit && npm test",
    "test": "tsx --test test/*.test.ts",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "npm run check && wrangler deploy",
    "login": "wrangler login",
    "secrets": "node scripts/secrets.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260906.1",
    "@types/node": "22.20.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "wrangler": "4.129.0"
  }
}
